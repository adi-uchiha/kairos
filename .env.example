# 🌐 Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Kairos

# 🔐 Better Auth Settings
# Generate a secure 32-character random string for BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=your_32_character_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000

# 💾 Database Connection (Neon / PostgreSQL)
# Neon connection string with sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-host-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 👥 Social Authentication Providers
# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 🧠 Gemini API Credentials (Server-side only — never expose to client)
# Kairos supports rotating multiple Gemini keys. 
# You can add as many as needed by incrementing the suffix number (e.g. GEMINI_KEY_1, GEMINI_KEY_2, ...).
GEMINI_KEY_1=AIzaSy_your_gemini_api_key_here
# GEMINI_KEY_2=AIzaSy_your_second_gemini_api_key_here
